#!/usr/bin/make -f

# Errors with default -Werror=format-security that needs to be
# patched and/or fixed upstream.
export DEB_CFLAGS_MAINT_APPEND = -Wno-format -Wno-format-security -Wl,-z,defs -DBACKEND_CONF_FILE=\"/etc/audioreach/agm/backend_conf.xml\"
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- --with-glib --with-syslog --with-no-ipc

override_dh_fixperms:
	dh_fixperms
	find debian -name "*.xml" -exec chmod 644 {} +
